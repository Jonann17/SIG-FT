    {
      "parameters": {
        "jsCode": "// Prepara a resposta ao SIG-FT. As instrucoes do agente moram no AMP, nao aqui.\nconst VERSAO = '2026-11-04';\nconst texto = String($input.first().json.output ?? '');\nconst binarios = $('Monta a mensagem').first().binary || {};\nconst arquivos = Object.values(binarios).map(b => b.fileName || '?');\nlet html = texto;\nconst inicio = html.search(/<!DOCTYPE html|<html/i);\nif (inicio > 0) html = html.slice(inicio);        // tira a narracao do agente antes do HTML\nconst fim = html.toLowerCase().lastIndexOf('</html>');\nif (fim >= 0) html = html.slice(0, fim + 7);      // e o que vier depois dele\nhtml = html.replace(/\\\\%/g, '%').trim();          // o agente escreve 100\\% no CSS\nconst ok = /<html|<table/i.test(html);\nconst resposta = { ok, modo: 'criar', html, arquivos, versao_workflow: VERSAO, execucao: $execution.id };\nif (!ok) resposta.erro = 'o agente não devolveu HTML';\nreturn [{ json: { resposta } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        220
      ],
      "id": "b493f2f5-9a72-5cf6-ac5f-2384b0d56538",
      "name": "Prepara a resposta"
    },
    {
      "parameters": {
        "jsCode": "// O erro do agente, guardado para a busca do SIG-FT.\nconst e = $input.first().json.error;\nconst erro = String((e && (e.message || e)) || 'erro sem mensagem');\nreturn [{ json: { resposta: { ok: false, modo: 'criar', etapa: 'agente', erro, versao_workflow: '2026-11-04', execucao: $execution.id } } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        400
      ],
      "id": "bcea339d-b8cb-5e67-80d3-124c8a33a59e",
      "name": "Prepara o erro"
    },
    {
      "parameters": {
        "jsCode": "// Guarda o resultado para a busca do SIG-FT (modo buscar), pelo numero do pedido: a execucao.\n// Os dados estaticos so persistem nas execucoes de producao (workflow publicado).\nconst dados = $getWorkflowStaticData('global');\ndados.resultados = dados.resultados || {};\nconst r = $input.first().json.resposta;\nconst pedido = String($execution.id);\ndados.resultados[pedido] = { ...r, estado: r.ok ? 'pronto' : 'erro', pedido, guardado_em: Date.now() };\nconst LIMITE = 30, VIDA = 7 * 24 * 3600 * 1000;\nconst ids = Object.keys(dados.resultados)\n  .sort((a, b) => dados.resultados[b].guardado_em - dados.resultados[a].guardado_em);\nids.forEach((id, i) => {\n  if (i >= LIMITE || Date.now() - dados.resultados[id].guardado_em > VIDA) delete dados.resultados[id];\n});\nreturn [{ json: { guardado: pedido, estado: dados.resultados[pedido].estado } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        300
      ],
      "id": "845ce42b-079b-573c-a195-1e6e1dd94865",
      "name": "Guarda o resultado"
    }
