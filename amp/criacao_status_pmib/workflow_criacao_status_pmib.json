    {
      "parameters": {
        "jsCode": "// Devolve o resultado guardado do pedido; ainda sem ele, 'pendente'.\nconst dados = $getWorkflowStaticData('global');\nconst pedido = String((($input.first().json.body) || {}).pedido || '');\nconst guardado = (dados.resultados || {})[pedido];\nconst resposta = guardado || { ok: true, modo: 'buscar', estado: 'pendente', pedido, versao_workflow: '2026-11-04' };\nreturn [{ json: { resposta } }];\n"
      },
