model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull
		fastCombine

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaPMIB", "DataReferencia", "fxNorm", "fxPMIB", "fxLerTabela", "fxData", "fxStatus", "fxTipoEntrega", "fxRevisaoEmUso", "Calendario", "PrecosArquivos", "PrecosPorPMIB", "PrecosAconex", "Itens", "Listas", "Atividades", "Eventos", "ListaEvento"]

annotation PBI_ProTooling = ["DevMode"]

queryGroup Parametros

	annotation PBI_QueryGroupOrder = 0

queryGroup Funcoes

	annotation PBI_QueryGroupOrder = 1

queryGroup Apoio

	annotation PBI_QueryGroupOrder = 2

ref table Calendario
ref table PrecosAconex
ref table Itens
ref table Listas
ref table Atividades
ref table Eventos
ref table ListaEvento
