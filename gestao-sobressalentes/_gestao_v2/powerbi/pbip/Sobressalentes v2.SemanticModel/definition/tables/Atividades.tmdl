table Atividades
	lineageTag: 070498e0-7cad-4962-8baf-d5d604c8822d

	measure 'Atividades Abertas' =
			CALCULATE ( COUNTROWS ( Atividades ), Atividades[Situacao] <> "CONCLUÍDA" )
		formatString: 0
		displayFolder: Plano de ação (aba Atividades)
		lineageTag: d6c230e0-871a-4067-9446-30922df46600

	measure 'Atividades Atrasadas' =
			CALCULATE ( COUNTROWS ( Atividades ), Atividades[Situacao] = "ATRASADA" )
		formatString: 0
		displayFolder: Plano de ação (aba Atividades)
		lineageTag: 4933a5cd-d476-4061-919c-117bbb6700c9

	measure 'Atividades Travadas' =
			CALCULATE ( COUNTROWS ( Atividades ), Atividades[Situacao] = "TRAVADA" )
		formatString: 0
		displayFolder: Plano de ação (aba Atividades)
		lineageTag: d7db0eb6-976e-443b-aa26-a53f858c2b5a

