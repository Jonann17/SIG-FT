table Itens
	lineageTag: 0e18e0ad-b9b4-40a6-93b1-b6578ffa42cd

	measure Fichas =
			CALCULATE ( DISTINCTCOUNT ( Itens[PMIB] ), Itens[E Ficha] = TRUE () )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 395867de-6926-4f0f-a64c-9b3a53291bb9

	measure 'Fichas Emitidas' =
			CALCULATE ( [Fichas], Itens[Emitida] = TRUE () )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 5976ec08-24cf-4d5f-978e-e6d3fb814cf2

	measure 'Fichas em Análise IB' =
			CALCULATE ( [Fichas], Itens[Status] = "EM ANÁLISE IB" )
		formatString: 0
		displayFolder: Fichas
		lineageTag: ca6f82ac-c5d5-477a-bc38-8281647dee2a

	measure 'Fichas em Correção' =
			CALCULATE ( [Fichas], Itens[Status] = "EM CORREÇÃO" )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 71e34d59-3f4e-488f-a0bd-477ddd589392

	measure 'Fichas Aprovadas' =
			CALCULATE ( [Fichas], Itens[Status] = "APROVADO" )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 5149ca91-7c43-4af0-82e7-e5c98cdff018

	measure 'Fichas em Preparação' =
			CALCULATE ( [Fichas], Itens[Status] IN { "INICIAR", "FICHA CRIADA", "COM O FORNECEDOR", "EM ELABORAÇÃO" } )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 9326fa43-3b82-4786-9d8b-8e3cd2275f2b

	measure 'Fichas com o Fornecedor' =
			CALCULATE ( [Fichas], Itens[Status] = "COM O FORNECEDOR" )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 7be2a66f-e6cb-4917-a076-b0db9de50508

	measure 'Fichas sem Status Válido' =
			CALCULATE ( [Fichas], Itens[Status] IN { "N/A", "SEM STATUS" } )
		formatString: 0
		displayFolder: Fichas
		lineageTag: 64f92736-d4fd-4222-986d-9b4650834981

	measure '% Emitidas' =
			DIVIDE ( [Fichas Emitidas], [Fichas] )
		formatString: 0%
		displayFolder: Fichas
		lineageTag: aff89416-3c33-4da8-b42a-e7c3e260f85e

	measure '% Aprovadas' =
			DIVIDE ( [Fichas Aprovadas], [Fichas] )
		formatString: 0%
		displayFolder: Fichas
		lineageTag: 314691a9-55de-4343-ac96-12d643666280

	measure 'Taxa de Aprovação das Emitidas' =
			DIVIDE ( [Fichas Aprovadas], [Fichas Emitidas] )
		formatString: 0%
		displayFolder: Fichas
		lineageTag: 7f896b10-61e9-4699-97b9-d42d0a5d023c

	measure 'Taxa de Devolução' =
			DIVIDE ( [Fichas em Correção], [Fichas Emitidas] )
		formatString: 0%
		displayFolder: Fichas
		lineageTag: 8e73c1fe-533c-47ad-bbda-f02624793c3f

	measure 'Fichas Info Fornecedor Completa' =
			CALCULATE ( [Fichas], Itens[Info Fornecedor OK] = TRUE () )
		formatString: 0
		displayFolder: Seções da ficha
		lineageTag: 22c7ac5f-61b9-424f-b0b6-c65afedd3a07

	measure 'Fichas Valorizadas' =
			CALCULATE ( [Fichas], Itens[Valorizacao OK] = TRUE () )
		formatString: 0
		displayFolder: Seções da ficha
		lineageTag: f2773f0f-c16f-4022-889c-2632770b0cdc

	measure 'Fichas com LMR' =
			CALCULATE ( [Fichas], Itens[LMR OK] = TRUE () )
		formatString: 0
		displayFolder: Seções da ficha
		lineageTag: 3c527a8d-31f3-4e98-ad5b-7b91a3a0d1d2

	measure '% Info Fornecedor' =
			DIVIDE ( [Fichas Info Fornecedor Completa], [Fichas] )
		formatString: 0%
		displayFolder: Seções da ficha
		lineageTag: 1d3de204-df5c-4c31-bb16-15b7cb32a606

	measure '% Valorização' =
			DIVIDE ( [Fichas Valorizadas], [Fichas] )
		formatString: 0%
		displayFolder: Seções da ficha
		lineageTag: 162db006-6323-40ac-8acb-01fc7265170a

	measure '% LMR' =
			DIVIDE ( [Fichas com LMR], [Fichas] )
		formatString: 0%
		displayFolder: Seções da ficha
		lineageTag: 2c88fa4f-6188-4d53-bc40-3e021bcff387

	measure 'Itens Físicos' =
			CALCULATE ( [Fichas], Itens[Tipo de Entrega] = "FÍSICA E DOCUMENTAL" )
		formatString: 0
		displayFolder: Tipo de entrega
		lineageTag: 18571670-cd13-4acb-9aab-afd3da5d8aa6

	measure 'Itens Físicos Entregues' =
			CALCULATE ( [Itens Físicos], Itens[Entregue] = TRUE () )
		formatString: 0
		displayFolder: Tipo de entrega
		lineageTag: 3165fa5d-d8ae-4aef-92da-13660bdcfa0b

	measure '% Físicos Entregues' =
			DIVIDE ( [Itens Físicos Entregues], [Itens Físicos] )
		formatString: 0%
		displayFolder: Tipo de entrega
		lineageTag: c3466409-d917-46bb-8fba-df905630a94b

	measure 'Fichas Documentais' =
			CALCULATE ( [Fichas], Itens[Tipo de Entrega] = "DOCUMENTAL" )
		formatString: 0
		displayFolder: Tipo de entrega
		lineageTag: 89bc50ad-1be4-4670-aebb-db7e27068e3c

	measure 'Fichas sem Tipo de Entrega' =
			CALCULATE ( [Fichas], Itens[Tipo de Entrega] = "NÃO CLASSIFICADO" )
		formatString: 0
		displayFolder: Tipo de entrega
		lineageTag: 21b9f0cc-2770-42c0-a3a0-78bb29d2e543

	measure 'Pedidos de Autorização' =
			CALCULATE ( [Fichas], NOT ISBLANK ( Itens[Data Email] ),
			            Itens[Situacao Autorizacao] IN { "AGUARDANDO ITAIPU", "ATRASADO ITAIPU", "AUTORIZADO", "AGUARDANDO CÁLCULO DO SIG-FT" } )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: fbf99793-8349-4fb9-972b-0bd2c6c4645a

	measure 'Fichas que Não Precisam de Autorização' =
			CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "N/A" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 3f8a578b-c89f-4c7e-83da-baa331e93eb8

	measure 'Pedidos de Autorização Pendentes' =
			[Aguardando Itaipu no Prazo] + [Autorizações Atrasadas Itaipu]
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: b3142568-c1cb-4b36-9a3f-0b2c9b639916

	measure 'Aguardando Itaipu no Prazo' =
			CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AGUARDANDO ITAIPU" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 846750e3-cf15-458c-a4da-2a42b83835f5

	measure 'Aguardando Cálculo do SIG-FT' =
			CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AGUARDANDO CÁLCULO DO SIG-FT" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: f1430791-c147-4f0e-9ee7-aa1a88525fa8

	measure 'Autorizações Atrasadas Itaipu' =
			CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "ATRASADO ITAIPU" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 672d8303-1eb8-4f6b-ab2f-f5b327d21758

	measure Autorizadas =
			CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AUTORIZADO" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 8c10d2e0-be70-40dd-b06f-603f60592319

	measure 'Autorizadas com Atraso' =
			// autorizadas cujo DIAS DE ATRASO ficou congelado acima de zero
			CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AUTORIZADO", Itens[Dias de Atraso] > 0 )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 0c92acf2-0c22-47d2-bf88-a23f54285e5c

	measure 'Maior Atraso Itaipu (dias)' =
			CALCULATE ( MAX ( Itens[Dias de Atraso] ), Itens[Situacao Autorizacao] = "ATRASADO ITAIPU" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 3e393350-24a6-40c5-b4ff-c6261e0f1559

	measure 'Atraso Médio Itaipu (dias)' =
			CALCULATE ( AVERAGE ( Itens[Dias de Atraso] ), Itens[Situacao Autorizacao] = "ATRASADO ITAIPU" )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 16ba988e-d05c-4ccc-9931-3d2326acbe08

	measure 'Aptas Aguardando Entrega' =
			CALCULATE ( [Itens Físicos], Itens[Apto] = TRUE (), Itens[Entregue] = FALSE () )
		formatString: 0
		displayFolder: Trilha logística: autorização de Itaipu (15 d.u.)
		lineageTag: 6765f68e-b1e9-42bf-ae96-1abe1e7a4a4b

	measure 'LMR Fora do Compromisso' =
			CALCULATE ( [Fichas], Itens[Situacao LMR] = "LMR FORA DO COMPROMISSO" )
		formatString: 0
		displayFolder: Trilha documental: compromisso de LMR (3 meses do e-mail)
		lineageTag: 4e120c90-80d8-4707-90ee-d4769ad737c4

	measure 'LMR em Atenção' =
			CALCULATE ( [Fichas], Itens[Situacao LMR] = "LMR EM ATENÇÃO" )
		formatString: 0
		displayFolder: Trilha documental: compromisso de LMR (3 meses do e-mail)
		lineageTag: 4d4b2abc-b8ad-4d9d-a5cd-587141760b63

	measure 'Maior Atraso LMR (dias)' =
			CALCULATE ( MAX ( Itens[Dias desde Email] ), Itens[Situacao LMR] = "LMR FORA DO COMPROMISSO" )
		formatString: 0
		displayFolder: Trilha documental: compromisso de LMR (3 meses do e-mail)
		lineageTag: 9512f7de-b0e4-42c1-9e1a-9fa7958793fa

	measure 'Valor Físico USD' =
			SUM ( Itens[Valor Linha USD] )
		formatString: #,##0
		displayFolder: Valor (lista de preços)
		lineageTag: f566987b-074d-4df1-a24c-61763a3dc9f7

	measure 'Valor Entregue USD' =
			// Ficha Entregue: a linha DUPLICADO herda o "entregue" da linha da ficha
			CALCULATE ( [Valor Físico USD], Itens[Ficha Entregue] = TRUE () )
		formatString: #,##0
		displayFolder: Valor (lista de preços)
		lineageTag: c30a8eb4-fa02-4ef6-9085-afbc6693914c

	measure 'Fichas Duplicadas de Outro Sistema' =
			CALCULATE ( [Fichas], Itens[Duplicada de Outro Sistema] = TRUE () )
		formatString: 0
		displayFolder: Valor (lista de preços)
		lineageTag: 472f77ba-cbc4-483c-9a62-5c85aaeffdcc

	measure '% Valor Entregue' =
			DIVIDE ( [Valor Entregue USD], [Valor Físico USD] )
		formatString: 0%
		displayFolder: Valor (lista de preços)
		lineageTag: 37f35ab9-85a2-49a2-a2ab-019c4abafb3d

	measure 'Fichas com Preço' =
			CALCULATE ( [Fichas], NOT ISBLANK ( Itens[Valor Unitario USD] ) )
		formatString: 0
		displayFolder: Valor (lista de preços)
		lineageTag: 036612f1-19ab-4a90-a87e-c12c1025a197

	measure 'Pendências CMI' =
			CALCULATE ( [Fichas], Itens[Pendencia] <> "—" )
		formatString: 0
		displayFolder: Fila de trabalho
		lineageTag: 5beace20-f845-4fdc-880e-1094e9d7bc5a

	measure 'Atualizado em' =
			"Dados de " & FORMAT ( MAX ( Itens[Data Referencia] ), "dd/mm/yyyy" )
		displayFolder: Rótulos
		lineageTag: 73e2fd86-ce03-4205-9360-37827615e305

	measure 'Rótulo Atraso Itaipu' =
			VAR N = [Autorizações Atrasadas Itaipu]
			RETURN IF ( N > 0, FORMAT ( N, "0" ) & " fichas aguardam autorização além de 15 dias úteis", "Nenhuma autorização fora do prazo" )
		displayFolder: Rótulos
		lineageTag: 20ef4f02-14f4-4c93-8c1c-e0de79858b71

