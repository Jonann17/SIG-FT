table Listas
	lineageTag: 52f5e708-1521-4ec9-aded-de619c210410

	measure Listas =
			COUNTROWS ( Listas )
		formatString: 0
		displayFolder: Listas
		lineageTag: bbc3ffcb-6a8b-4fd2-b5b0-a4ff7c85db9e

	measure 'Listas Aprovadas EN.DT' =
			CALCULATE ( [Listas], Listas[Status Real] = "APROVADO" )
		formatString: 0
		displayFolder: Listas
		lineageTag: e2ce58e0-3cbd-452d-a07b-79acb2d30590

	measure 'Listas com Fichas' =
			COUNTROWS ( FILTER ( Listas, [Fichas] > 0 ) )
		formatString: 0
		displayFolder: Listas
		lineageTag: 1a2d99a0-eeff-4e62-b039-aabe1dd06689

	measure 'Listas Aprovadas sem Fichas' =
			COUNTROWS ( FILTER ( Listas, Listas[Status Real] = "APROVADO" && ( ISBLANK ( [Fichas] ) || [Fichas] = 0 ) ) )
		formatString: 0
		displayFolder: Listas
		lineageTag: 6a1ce1b2-4bf7-4ce1-bb66-ad9cd3ff9022

	measure 'Listas sem Responsável' =
			CALCULATE ( [Listas], Listas[Tem Responsavel] = FALSE () )
		formatString: 0
		displayFolder: Listas
		lineageTag: 68f60f15-96e2-43d7-b85c-ccdd4fe2dc6d

	measure 'Listas com Revisão Desatualizada' =
			// a revisão em uso no _STATUS_PMIB não é a última emitida no Aconex
			CALCULATE ( [Listas], Listas[Revisao Desatualizada] = TRUE () )
		formatString: 0
		displayFolder: Listas
		lineageTag: 4fc630de-eb90-4e1b-b331-4394768b71a1

