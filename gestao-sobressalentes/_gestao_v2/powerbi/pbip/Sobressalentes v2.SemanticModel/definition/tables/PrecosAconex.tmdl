table PrecosAconex
	lineageTag: 955a084e-7f0c-4239-a1b6-b14242f6ec09

	measure 'Listas de Preços Emitidas' =
			COUNTROWS ( PrecosAconex )
		formatString: 0
		displayFolder: Listas de preços (Aconex)
		lineageTag: c1536b39-0207-437d-9cf4-c6c0a346a901

	measure 'Listas de Preços Aprovadas SM.DT' =
			CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Situacao Preco] = "APROVADA SM.DT" )
		formatString: 0
		displayFolder: Listas de preços (Aconex)
		lineageTag: d1e3e31f-ac01-43bc-a985-8089234b5c6d

	measure 'Listas de Preços no Código Antigo' =
			CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Geracao] = "PB020-0x (legado)" )
		formatString: 0
		displayFolder: Listas de preços (Aconex)
		lineageTag: 3271708d-c188-4fed-8840-90169642fd46

